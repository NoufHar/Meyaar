# ── Meyaar Error Analysis Agent configuration ───────────────────────────────
# Copy to .env (repo .gitignore already excludes .env) and fill in.

# Database — defaults match the team PostGIS setup (src/insertion/database.py).
# MEYAAR_DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/meyaar_db
# Connections are opened with default_transaction_read_only=on automatically.

# LLM — any OpenAI-compatible provider. If unset, the agent runs fully
# deterministic (no API calls): analyses come from the template engine with
# the same JSON schema. Heuristic classification never depends on the LLM.
MEYAAR_LLM_API_KEY=
# Optional — point at any OpenAI-compatible endpoint, e.g. DeepSeek:
# MEYAAR_LLM_BASE_URL=https://api.deepseek.com/v1
# MEYAAR_LLM_MODEL=deepseek-chat (Bader Used minimax/minimax-m3:free through
#                                 OpenRouter worked well)
MEYAAR_LLM_TEMPERATURE=0.0
MEYAAR_LLM_MAX_TOKENS=2048
MEYAAR_LLM_RETRIES=2
# MEYAAR_ALLOW_LLM=false

# ── Voice (thin integration) ────────────────────────────────────────────────
# TTS engine for the CLI chat --speak: macos ('say', default) | none
# MEYAAR_TTS_ENGINE=macos
# STT is done in the browser (Web Speech API) by the chat UI for now.
# MEYAAR_STT_ENGINE=none